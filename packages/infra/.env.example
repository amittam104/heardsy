# Required: 32+ char random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Optional: the Worker's name, which sets its address (<name>.<your-subdomain>.workers.dev). Blank derives one from the stage.
WORKER_NAME=

# Your root domain for multi-workspace subdomains (e.g. openheard.com). Leave blank for single-workspace.
ROOT_DOMAIN=

# Public URL of the worker. Defaults to the Cloudflare .workers.dev URL if blank. Set to your custom domain (e.g. https://openheard.com) for cross-subdomain auth cookies.
BETTER_AUTH_URL=

# Optional: the image shown when someone shares a link to your board (1200x630 works best). Blank uses the openheard one.
OG_IMAGE_URL=

# Optional: your own Terms and Privacy pages. /terms and /privacy redirect there; blank keeps the built-in ones.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=

# Optional: where the footer's Source link points. AGPL: if you run a modified version, point this at your source.
SOURCE_URL=

# Optional: the sender for magic links and notifications. Must be on a domain with Cloudflare Email Sending enabled.
# Leave blank to deploy without email: sign-in links and notifications are only logged.
EMAIL_FROM=
EMAIL_FROM_NAME=
# Optional: where replies go. Useful when EMAIL_FROM is a send-only address with no inbox.
EMAIL_REPLY_TO=

# Optional: Google OAuth for "Sign in with Google". Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: behind Cloudflare Access, sign people in with their Access identity instead of a second login.
# Team domain from Zero Trust > Settings (e.g. yourteam.cloudflareaccess.com); AUD tag from the Access application's overview.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: browser analytics (OpenPanel). Build-time, so these are public.
VITE_OPENPANEL_CLIENT_ID=
VITE_OPENPANEL_URL=

# The official Heardsy feedback board. Its widget loads only on the marketing pages
# of a ROOT_DOMAIN it lives under, so self-hosted installs never load it.
VITE_OFFICIAL_FEEDBACK_BOARD=

# Optional: server-side revenue tracking from the Stripe webhook. Needs a
# client with write access, which is a different client from the VITE_ one
# above. Leave blank and no analytics request is ever made.
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
# Ingest base URL, the one /track hangs off. Blank uses OpenPanel cloud. When
# self-hosting this is the API origin, which is the client URL plus /api.
OPENPANEL_URL=
